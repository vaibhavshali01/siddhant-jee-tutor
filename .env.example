# Copy to .env and fill in. Never commit the real file.

# From https://console.x.ai — this key stays on the server, never in the browser.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# How hard Grok thinks. grok-4.7 accepts low, medium, high, or xhigh.
# High is the default. Advanced questions and photo questions use xhigh.
# Hints use low and practice questions use medium, so those stay faster.
XAI_REASONING_EFFORT=high

# Code execution checks arithmetic on worked solutions.
# auto = on for worked solutions, off for hints and practice. Also: on, off.
XAI_CODE_EXECUTION=auto

# Web search stays off. Turn it on only if you want the tutor to look up a constant.
# It can pull messy web text into an answer, so leave it false unless you need it.
XAI_WEB_SEARCH=false

# Photo questions are sent at this detail. high is the sharpest.
XAI_IMAGE_DETAIL=high

# Reasoning can take minutes. The docs ask for at least 900 seconds.
XAI_TIMEOUT_SECONDS=900

# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# You are the only approver. This account is created on first boot and is already approved.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Vaibhav

# Optional phone/desktop ping when someone requests access.
# Easiest: install ntfy, subscribe to a secret topic, put the URL here.
# Example: https://ntfy.sh/siddhant-jee-your-secret-topic
ADMIN_NOTIFY_URL=

# Comma-separated extra admin emails (optional).
EXTRA_ADMINS=

# Daily student message cap. Admins are uncapped.
DAILY_MESSAGE_CAP=40

# Cookie Secure flag. Set true behind HTTPS (Render, Railway, Fly).
COOKIE_SECURE=false

DATABASE_PATH=data/siddhant.db
PORT=8000
